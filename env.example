# Copy this file to .env and change the values. Never commit .env.
# Production: APP_ENV=production refuses to start until the values marked [prod] are safe
# (docs/step-14-hardening.md).

APP_ENV=development
# [prod] random, 32+ characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Database ([prod] a strong password, 12+ characters, the same in both lines)
POSTGRES_USER=claimguard
POSTGRES_PASSWORD=claimguard
POSTGRES_DB=claimguard
DATABASE_URL=postgresql+psycopg://claimguard:claimguard@postgres:5432/claimguard

# Queue
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=claimguard

# File storage: "local" keeps files in a Docker volume; "s3" for any S3-compatible service
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage
S3_ENDPOINT_URL=
S3_BUCKET=claimguard
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# Dashboard address allowed to call the API ([prod] the https:// address people open)
CORS_ORIGINS=["http://localhost:5174"]

# AI: ollama (local, nothing leaves the machine), anthropic (external, needs a key), blank = rules only
AI_PROVIDER=
AI_API_KEY=
# AI_MODEL=qwen2.5vl:7b   (with ollama)
# [prod] an external provider (anthropic) is refused unless this is true. Set it only with the client's written
# approval and a DPDP Act check.
ALLOW_EXTERNAL_AI=false

# Production only: the port nginx serves the dashboard on (behind your HTTPS proxy)
HTTP_PORT=8080
