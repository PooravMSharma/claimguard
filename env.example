# Copy this file to .env and change the values. Never commit .env.

APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database
POSTGRES_USER=claimguard
POSTGRES_PASSWORD=claimguard
POSTGRES_DB=claimguard
DATABASE_URL=postgresql+psycopg://claimguard:claimguard@postgres:5432/claimguard

# Queue
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=claimguard

# File storage: "local" for development, "s3" for production
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage
S3_ENDPOINT_URL=
S3_BUCKET=claimguard
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# Frontend origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]

# AI provider (used from Step 7 onwards; leave blank for now)
AI_PROVIDER=
AI_API_KEY=
